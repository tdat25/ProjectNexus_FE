# Copy file này thành .env.development rồi điền giá trị thật

# URL của API Gateway
# - Dev local: để trống (Vite proxy tự xử lý)
# - Staging/Production: điền URL Gateway thật
VITE_API_BASE_URL=

# URL Gateway để vite.config.ts biết proxy target (chỉ dùng trong dev)
VITE_GATEWAY_URL=http://localhost:5000

# Google OAuth Client ID — lấy từ Google Cloud Console
# Project: Nexus-Marketplace → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=873246862137-3rc9et8np7go1r2a1qita7441631lo30.apps.googleusercontent.com
